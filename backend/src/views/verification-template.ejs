<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <style>
      @import url("https://fonts.googleapis.com/css2?family=Fira+Sans:wght@300;400;600&display=swap");

      body {
        width: 100%;
        font-family: "Fira Sans", sans-serif;
      }

      .mail-box {
        width: 90%;
        border: 2px solid #d1d9d9;
        text-align: center;
        border-radius: 10px;
        padding-bottom: 60px;
        margin: auto;
      }

      .mail-box h3 {
        font-weight: 400;
        padding: 0 15px;
      }

      .mail-box .bg-img {
        width: 100%;
      }

      .mail-box .mail-icon {
        width: 64px;
        height: 64px;
        display: block;
        margin: auto;
        margin-top: 100px;
        margin-bottom: 40px;
      }

      .mail-box .btn-verify {
        text-decoration: none;
        color: #fff;
        background: #1a73e8;
        padding: 12px;
        border-radius: 5px;
        font-size: 1rem;
        font-weight: 500;
      }
      #copy{
        cursor: pointer;
        margin-left: 4px;
      }
    </style>
  </head>

  <body>
    <div class="mail-box">
      <img
        src="https://res.cloudinary.com/do63p55lo/image/upload/v1735453922/videotube/email-bg_il63wh.png"
        alt="Welcome to ElectronicStore"
        class="bg-img"
      />
      <h1>Hello, <%= name %></h1>
      <h3>Welcome to Videotube.<br />Thankyou for Registering on Videotube.</h3>

      <img
        src="https://res.cloudinary.com/do63p55lo/image/upload/v1640519899/ElectonicStore/email/mail-icon_af7ymy.png"
        alt="mail-icon"
        class="mail-icon"
      />
      <p>
        We are providing an OTP for verification.. The code is valid for 10
        minutes and usable only once.<br />
        You will be able to access our fantastic product after you have
        validated the code. This is to guarantee that your account is only
        accessible by you.
      </p>
      <span style="display: flex; align-items: center; justify-content: center"
        >Your OTP: <strong><%= otp %></strong>
        <span id="copy">
          <svg
            width="18"
            height="18"
            viewBox="0 0 24 24"
            fill="none"
            xmlns="http://www.w3.org/2000/svg"
          >
            <g id="SVGRepo_bgCarrier" stroke-width="0"></g>
            <g
              id="SVGRepo_tracerCarrier"
              stroke-linecap="round"
              stroke-linejoin="round"
            ></g>
            <g id="SVGRepo_iconCarrier">
              <path
                d="M6 11C6 8.17157 6 6.75736 6.87868 5.87868C7.75736 5 9.17157 5 12 5H15C17.8284 5 19.2426 5 20.1213 5.87868C21 6.75736 21 8.17157 21 11V16C21 18.8284 21 20.2426 20.1213 21.1213C19.2426 22 17.8284 22 15 22H12C9.17157 22 7.75736 22 6.87868 21.1213C6 20.2426 6 18.8284 6 16V11Z"
                stroke="#000000"
                stroke-width="1.5"
              ></path>
              <path
                d="M6 19C4.34315 19 3 17.6569 3 16V10C3 6.22876 3 4.34315 4.17157 3.17157C5.34315 2 7.22876 2 11 2H15C16.6569 2 18 3.34315 18 5"
                stroke="#000000"
                stroke-width="1.5"
              ></path>
            </g>
          </svg>
        </span>
      </span>
      <br />
      <span>Expires in: <strong>10 minutes</strong></span>
    </div>
  </body>
</html>
